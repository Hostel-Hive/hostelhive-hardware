{
  "version": 1,
  "author": "Hasinthaka Piyumal",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "board-ssd1306", "id": "oled", "top": -120, "left": -120, "attrs": { "i2cAddress": "0x3c" } },
    { "type": "wokwi-led", "id": "led_green", "top": -80, "left": 80, "attrs": { "color": "green" } },
    { "type": "wokwi-led", "id": "led_red", "top": -80, "left": 130, "attrs": { "color": "red" } },
    { "type": "wokwi-buzzer", "id": "buzzer", "top": -60, "left": 180, "attrs": { "volume": "0.2" } },
    { "type": "wokwi-relay-module", "id": "relay", "top": 120, "left": -120, "attrs": {} },
    { "type": "wokwi-pushbutton", "id": "btn_override", "top": 140, "left": 120, "attrs": { "color": "blue", "label": "Manual Override" } },
    { "type": "wokwi-resistor", "id": "r_green", "top": -30, "left": 80, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r_red", "top": -30, "left": 130, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r_override_pullup", "top": 110, "left": 120, "attrs": { "value": "10000" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "esp:GND.1", "oled:GND", "black", [ "v0" ] ],
    [ "esp:3V3", "oled:VCC", "red", [ "v0" ] ],
    [ "esp:21", "oled:SDA", "blue", [ "v0" ] ],
    [ "esp:22", "oled:SCL", "yellow", [ "v0" ] ],

    [ "esp:18", "r_green:1", "green", [ "v0" ] ],
    [ "r_green:2", "led_green:A", "green", [ "v0" ] ],
    [ "led_green:C", "esp:GND.1", "black", [ "v0" ] ],

    [ "esp:19", "r_red:1", "orange", [ "v0" ] ],
    [ "r_red:2", "led_red:A", "orange", [ "v0" ] ],
    [ "led_red:C", "esp:GND.1", "black", [ "v0" ] ],

    [ "esp:23", "buzzer:2", "purple", [ "v0" ] ],
    [ "buzzer:1", "esp:GND.1", "black", [ "v0" ] ],

    [ "esp:27", "relay:IN", "magenta", [ "v0" ] ],
    [ "esp:5V", "relay:VCC", "red", [ "v0" ] ],
    [ "esp:GND.2", "relay:GND", "black", [ "v0" ] ],

    [ "esp:34", "btn_override:1.r", "cyan", [ "v0" ] ],
    [ "btn_override:2.r", "esp:GND.2", "black", [ "v0" ] ],
    [ "esp:34", "r_override_pullup:1", "cyan", [ "v0" ] ],
    [ "r_override_pullup:2", "esp:3V3", "red", [ "v0" ] ]
  ],
  "dependencies": {}
}
